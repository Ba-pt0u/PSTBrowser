<Window x:Class="PstBrowser.App.Windows.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="820" WindowStartupLocation="CenterOwner" Icon="/Resources/app.ico">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Copier" Style="{StaticResource ToolButton}" Click="Copy_Click"/>
            <Button Content="Fermer" Style="{StaticResource ToolButton}" IsCancel="True" Click="Close_Click" Margin="0"/>
        </StackPanel>
        <TextBox x:Name="Text" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
