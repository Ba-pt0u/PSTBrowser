<Window x:Class="PstBrowser.App.Windows.SourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sources du dossier d'affaire" Height="560" Width="1100" WindowStartupLocation="CenterOwner" Icon="/Resources/app.ico">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8">
            Les fichiers sources sont ouverts en lecture seule et ne sont jamais modifiés. Les parties d'une même boîte (export découpé) doivent avoir le même nom
            de boîte : elles sont alors fusionnées dans l'arborescence. Double-cliquez sur la colonne « Boîte » pour la modifier.
        </TextBlock>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Indexations simultanées :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbParallel" Width="60" SelectionChanged="Options_Changed">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                </ComboBox>
                <TextBlock Text="(1 sur disque dur, 2 à 4 sur SSD)" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,16,0"/>
                <CheckBox x:Name="ChkSha" Content="Calculer l'empreinte SHA-256 des fichiers (traçabilité)" VerticalAlignment="Center" Click="Options_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Réindexer" Style="{StaticResource ToolButton}" Click="Reindex_Click" ToolTip="Supprime l'index de cette source et la réindexe entièrement"/>
                <Button Content="Retirer du dossier" Style="{StaticResource ToolButton}" Click="Remove_Click" ToolTip="Retire la source de l'index (le fichier n'est pas supprimé)"/>
                <Button Content="Copier la liste" Style="{StaticResource ToolButton}" Click="Copy_Click"/>
                <Button Content="Fermer" Style="{StaticResource ToolButton}" IsCancel="True" Click="Close_Click" Margin="0"/>
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="SourcesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE" BorderBrush="{StaticResource BorderBrush}"
                  CellEditEnding="Grid_CellEditEnding" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Boîte" Binding="{Binding MailboxName, UpdateSourceTrigger=LostFocus}" Width="220"/>
                <DataGridTextColumn Header="Fichier / dossier" Binding="{Binding DisplayName}" IsReadOnly="True" Width="240"/>
                <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="État" Binding="{Binding StatusText}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Éléments" Binding="{Binding CountText}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
