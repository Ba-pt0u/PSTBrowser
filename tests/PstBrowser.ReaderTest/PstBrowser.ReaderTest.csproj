<Project Sdk="Microsoft.NET.Sdk">

  <!-- Proves that displaying a hostile message with the secure reader (macOS / Linux) makes no network request.
       Run by .github/workflows/build.yml: dotnet run -c Release (Linux: under xvfb-run). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PstBrowser.Reader\PstBrowser.Reader.csproj" />
    <ProjectReference Include="..\..\src\PstBrowser.Core\PstBrowser.Core.csproj" />
  </ItemGroup>

</Project>
